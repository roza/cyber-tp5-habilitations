{
  "name": "TP5 habilitations (PHP + MariaDB)",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3-bookworm",
  "postCreateCommand": "bash .devcontainer/installer-mariadb.sh",
  "postStartCommand": "sudo service mariadb start",
  "containerEnv": {
    "DB_SOCKET": "/run/mysqld/mysqld.sock",
    "DB_ADMIN": "admin",
    "DB_ADMIN_PASS": "admin"
  },
  "customizations": {
    "vscode": { "extensions": ["cweijan.vscode-mysql-client2"] }
  }
}
